---
import MainLayout from "../layouts/MainLayout.astro";
import BlurAddon from "../components/BlurAddon.astro";
import TalkSection from "../components/TalkSection.astro"

const title = "Nosotros";
---

<MainLayout
  title="Nosotros | Origen.haus — Aquí es donde todo empieza"
  description="Origen — Estudio creativo de branding, diseño web y contenido de marca">

      <main id="origen-page-content" class="origen-page-content">

<BlurAddon />

      <div class="origen-section blur-section">
        <div class="origen-container fullwidth-container">

          <div class="origen-block">
            <div class="inner-headline fullheight">

              <div class="inner-headline__absolute">
                <div class="origen-container">
                  <div class="inner-headline__centered">
                    <div class="inner-headline__link loading-item">
                      <a class="btn btn-line btn-line-default" href="#process">
                        <span class="btn-caption origen-scramble">Origen Haus</span>
                      </a>
                    </div>
                    <div class="inner-headline__title banners-hover centered loading-item">
                      <h1 class="small">Creamos para tu marca
                        <a class="inner-headline__trigger banners-trigger-1" href="/proyectos"> experiencias </a> 
                        y  
                        <a class="inner-headline__trigger banners-trigger-2" href="/servicios"> soluciones de diseño</a>
                      </h1>
                    </div>

                    <div class="headline-banner-01 landscape image-01">
                      <img src="/img/illustrations/about-us-01.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-01 portrait image-02">
                      <img src="/img/illustrations/about-us-02.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-01 landscape image-03">
                      <img src="/img/illustrations/about-us-03.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-01 portrait image-04">
                      <img src="/img/illustrations/about-us-04.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-02 portrait image-05">
                      <img src="/img/illustrations/about-us-05.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-02 landscape image-06">
                      <img src="/img/illustrations/about-us-06.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-02 portrait image-07">
                      <img src="/img/illustrations/about-us-07.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-02 landscape image-08">
                      <img src="/img/illustrations/about-us-08.webp" alt="Imagen acerca de Origen">
                    </div>
                  </div>
                </div>
              </div>

              <div class="inner-headline__dataline">
                <div class="origen-container">
                  <div class="headline-dataline">
                    <div class="headline-dataline__socials">
                      <ul class="origen-socials-line centered-mobile">
                        <li class="loading-item">
                          <a class="origen-socials-line__link" href="https://instagram.com/byorigenhaus" target="_blank">
                            <span class="origen-scramble">@byorigenhaus</span>
                          </a>
                        </li>
                      </ul>
                    </div>
                    <div class="headline-dataline__controls loading-item">
                      <a class="btn btn-line-icon btn-line-icon-small btn-line-default slide-down" href="#process">
                        <span class="btn-caption origen-scramble">Desliza para ver más</span>
                        <i>
                          <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 18 18">
                            <path d="M18,10.8h-3.6v-3.6h3.6v3.6ZM7.2,14.4v3.6h3.6v-3.6h3.6v-3.6h-3.6V0h-3.6v10.8h-3.6v3.6s3.6,0,3.6,0ZM3.6,10.8v-3.6H0v3.6h3.6Z"/>
                          </svg>
                        </i>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
              <div class="origen-container grid-l-container">
                <div class="container-fluid p-0">
                  <div class="row g-0">
                    <div class="col-12 origen-grid-item">

                      <div class="inner-headline__breadcrumbs loading-fade">
                        <div class="breadcrumbs__nav">
                          <span>
                            <a href="/">
                              <span class="origen-scramble">Inicio</span>
                            </a>
                          </span>
                          <span class="current-item">Nosotros
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>


        </div>
      </div>

      <div class="origen-section blur-section">
        <div class="origen-container fullwidth-container">
          <div class="origen-divider">
            <div class="origen-divider__image divider-image-1 parallax-img"></div>
          </div>
        </div>
      </div>



      <div id="process" class="origen-section blur-section padding-top-manifest-m padding-bottom-tag-m-desktop">
        <div class="origen-container grid-l-container">


          <div class="origen-block">
            <div class="origen-section-manifest pre-points">
              <div class="container-fluid p-0">
                <div class="row g-0">
                  <div class="col-12 origen-grid-item">
                    <div class="origen-section-manifest__wrap wrap-text-m">
                      <div class="origen-section-manifest__text manifest-text-m">
                        <a class="manifest manifest-m origen-split-lines active-cursor-accent" data-cursor-text="View Works" href="works-default.html">
                          Así es como hacemos que  
                          <span>tu marca hable por si sola:</span>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="origen-block">
            <div class="origen-process-points">
              <div class="container-fluid p-0">
                <div class="row g-0">

                  <div class="col-12 col-xl-4 origen-process-points__item origen-grid-item">
                    <div class="origen-process-points__divider top anim-uni-clip-in"></div>
                    <div class="origen-process-points__title anim-uni-in-up">
                      <div class="origen-process-points__icon">
                        <i class="ph ph-crosshair"></i>
                      </div>
                      <p>Estrategia</p>
                    </div>
                    <div class="origen-process-points__descr">
                      <p class="t-medium origen-split-lines">Con tu idea en mente, planteamos una estrategia, desarrollamos un brief y avanzamos en toda la estructura del proyecto..</p>
                    </div>
                    <div class="origen-process-points__time anim-uni-in-up">
                      <span class="tag tag-m meta-time">1-2 semanas</span>
                    </div>
                  </div>

                  <div class="col-12 col-xl-4 origen-process-points__item origen-grid-item">
                    <div class="origen-process-points__divider top anim-uni-clip-in"></div>
                    <div class="origen-process-points__title anim-uni-in-up">
                      <div class="origen-process-points__icon">
                        <i class="ph ph-bezier-curve"></i>
                      </div>
                      <p>Diseño</p>
                    </div>
                    <div class="origen-process-points__descr">
                      <p class="t-medium origen-split-lines">Diseñamos y creamos las fases del proyecto, sea una marca, un sitio web, audiovisual o estrategia digital..</p>
                    </div>
                    <div class="origen-process-points__time anim-uni-in-up">
                      <span class="tag tag-m meta-time">~2 semanas</span>
                    </div>
                  </div>

                  <div class="col-12 col-xl-4 origen-process-points__item origen-grid-item">
                    <div class="origen-process-points__divider top anim-uni-clip-in"></div>
                    <div class="origen-process-points__title anim-uni-in-up">
                      <div class="origen-process-points__icon">
                        <i class="ph ph-codesandbox-logo"></i>
                      </div>
                      <p>Soporte</p>
                    </div>
                    <div class="origen-process-points__descr">
                      <p class="t-medium origen-split-lines">Brindamos apoyo a tu proyecto una vez esté al 100%, este acompañamiento sirve para que tu idea sea exitosa.</p>
                    </div>
                    <div class="origen-process-points__time anim-uni-in-up">
                      <span class="tag tag-m meta-time">3 semanas</span>
                    </div>
                    <div class="origen-process-points__divider bottom anim-uni-clip-in"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>


        </div>
      </div>

      <div class="origen-section blur-section">
        <div class="origen-container fullwidth-container">


          <div class="origen-block">
            <div class="marquee marquee-left--gsap">
              <div class="marquee__toleft marquee__images">

                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_01.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>

                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_02.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_03.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_04.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_05.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_06.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_07.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_08.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_09.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>

              </div>
            </div>

            <div class="marquee marquee-right--gsap">
              <div class="marquee__toright marquee__images align-start">

                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_09.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_08.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_07.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_06.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_05.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_04.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_03.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_02.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
                 
                <div class="marquee__item item-imageblock">
                  <div class="marquee__image">
                    <img src="/img/cta/mar_01.webp" alt="Imagen de proyectos de Origen">
                  </div>
                </div>
              </div>
            </div>
          </div>
          

        </div>
      </div>




      <div class="origen-section blur-section padding-top-subtitle padding-bottom-tag-m-subtitle">
        <div class="origen-container grid-s-container">

          <div class="origen-block">
            <div class="origen-block-split">
              <div class="container-fluid p-0">
                <div class="row g-0">
                  <div class="col-12 col-xl-6 origen-grid-item-s origen-block-split__item manifest-item">
                    <div class="origen-block-split__inner">
                      <div class="origen-block-split__subtitle pre-manifest">
                        <p class="anim-uni-in-up">
                          <span>/ Nosotros</span>
                        </p>
                      </div>
                      <div class="origen-block-split__manifest">
                        <p class="manifest manifest-s origen-split-lines">
                          Sabemos la importancia de que tu proyecto de marca, tu sitio web, las comunicaciones o la estrategia digital de tu negocio
                          <span>hablen bien de lo que haces y de lo que importa para tus clientes.</span>
                        </p>
                      </div>
                    </div>
                  </div>
                  <div class="col-12 col-xl-6 origen-grid-item-s origen-block-split__item manifest-item">
                    <div class="origen-block-split__inner">
                      <div class="origen-block-split__subtitle pre-grid">
                        <p class="anim-uni-in-up">
                          <span>/ Algunos datos</span>
                        </p>
                      </div>

                      <div class="origen-stats-lines">

                        <div class="origen-stats-lines__item">
                          <div class="origen-stats-lines__divider divider-top"></div>
                          <div class="origen-stats-lines__inner origen-stats-lines__anim">
                            <div class="origen-stats-lines__number">
                              <p id="stats-counter-1">30+</p>
                            </div>
                            <div class="origen-stats-lines__caption">
                              <p>Clientes felices que creen en nosotros</p>
                            </div>
                          </div>
                        </div>

                        <div class="origen-stats-lines__item">
                          <div class="origen-stats-lines__divider divider-top"></div>
                          <div class="origen-stats-lines__inner origen-stats-lines__anim">
                            <div class="origen-stats-lines__number">
                              <p id="stats-counter-2">94%</p>
                            </div>
                            <div class="origen-stats-lines__caption">
                              <p>Clientes que nos refieren con otros clientes</p>
                            </div>
                          </div>
                        </div>

                        <div class="origen-stats-lines__item">
                          <div class="origen-stats-lines__divider divider-top"></div>
                          <div class="origen-stats-lines__inner origen-stats-lines__anim">
                            <div class="origen-stats-lines__number">
                              <p id="stats-counter-3">7+</p>
                            </div>
                            <div class="origen-stats-lines__caption">
                              <p>Años de experiencia</p>
                            </div>
                          </div>
                        </div>

                        <div class="origen-stats-lines__item">
                          <div class="origen-stats-lines__divider divider-top"></div>
                          <div class="origen-stats-lines__inner origen-stats-lines__anim">
                            <div class="origen-stats-lines__number">
                              <p id="stats-counter-4">45+</p>
                            </div>
                            <div class="origen-stats-lines__caption">
                              <p>Proyectos completados</p>
                            </div>
                          </div>
                        </div>
                      </div>

                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>


        </div>
      </div>


      
<TalkSection />

    </main>

</MainLayout>
