        </div>
      </div>


      <!-- Section - Process Start -->
      <div id="process" class="origen-section blur-section padding-top-manifest-m padding-bottom-tag-m-desktop">
        <div class="origen-container grid-l-container">

          <!-- Block - Manifest Large Start -->
          <div class="origen-block">
            <div class="origen-section-manifest pre-points">
              <div class="container-fluid p-0">
                <div class="row g-0">
                  <div class="col-12 origen-grid-item">
                    <div class="origen-section-manifest__wrap wrap-text-m">
                      <div class="origen-section-manifest__text manifest-text-m">
                        <a class="manifest manifest-m origen-split-lines active-cursor-accent" data-cursor-text="View Works" href="works-default.html">
                          We are a creative web agency specializing in innovative design and cutting-edge development. 
                          <span>We help businesses stand out and thrive in the modern landscape.</span>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- Block - Manifest Large End -->

          <!-- Block - Process Points Start -->
          <div class="origen-block">
            <div class="origen-process-points">
              <div class="container-fluid p-0">
                <div class="row g-0">
                  <!-- process item -->
                  <div class="col-12 col-xl-4 origen-process-points__item origen-grid-item">
                    <div class="origen-process-points__divider top anim-uni-clip-in"></div>
                    <div class="origen-process-points__title anim-uni-in-up">
                      <div class="origen-process-points__icon">
                        <i class="ph ph-crosshair"></i>
                      </div>
                      <p>Strategy</p>
                    </div>
                    <div class="origen-process-points__descr">
                      <p class="t-medium origen-split-lines">Discover how artificial intelligence is transforming artistic processes, 
                        pushing boundaries, and inspiring new possibilities in digital design.</p>
                    </div>
                    <div class="origen-process-points__time anim-uni-in-up">
                      <span class="tag tag-m meta-time">1-2 weeks timeline</span>
                    </div>
                  </div>
                  <!-- process item -->
                  <div class="col-12 col-xl-4 origen-process-points__item origen-grid-item">
                    <div class="origen-process-points__divider top anim-uni-clip-in"></div>
                    <div class="origen-process-points__title anim-uni-in-up">
                      <div class="origen-process-points__icon">
                        <i class="ph ph-bezier-curve"></i>
                      </div>
                      <p>Design</p>
                    </div>
                    <div class="origen-process-points__descr">
                      <p class="t-medium origen-split-lines">Discover how artificial intelligence is transforming artistic processes, 
                        pushing boundaries, and inspiring new possibilities in digital design.</p>
                    </div>
                    <div class="origen-process-points__time anim-uni-in-up">
                      <span class="tag tag-m meta-time">~2 weeks timeline</span>
                    </div>
                  </div>
                  <!-- process item -->
                  <div class="col-12 col-xl-4 origen-process-points__item origen-grid-item">
                    <div class="origen-process-points__divider top anim-uni-clip-in"></div>
                    <div class="origen-process-points__title anim-uni-in-up">
                      <div class="origen-process-points__icon">
                        <i class="ph ph-codesandbox-logo"></i>
                      </div>
                      <p>Development</p>
                    </div>
                    <div class="origen-process-points__descr">
                      <p class="t-medium origen-split-lines">Discover how artificial intelligence is transforming artistic processes, 
                        pushing boundaries, and inspiring new possibilities in digital design.</p>
                    </div>
                    <div class="origen-process-points__time anim-uni-in-up">
                      <span class="tag tag-m meta-time">3-4 weeks timeline</span>
                    </div>
                    <div class="origen-process-points__divider bottom anim-uni-clip-in"></div>
                  </div>
