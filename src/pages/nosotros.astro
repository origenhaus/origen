---
import MainLayout from "../layouts/MainLayout.astro";
import BlurAddon from "../components/BlurAddon.astro";

const title = "Nosotros";
---

<MainLayout
  title="Nosotros | Origen.haus — Aquí es donde todo empieza"
  description="Origen — Estudio creativo de branding, diseño web y contenido de marca">

      <main id="origen-page-content" class="origen-page-content">

<BlurAddon />

      <div class="origen-section blur-section">
        <div class="origen-container fullwidth-container">

          <div class="origen-block">
            <div class="inner-headline fullheight">

              <div class="inner-headline__absolute">
                <div class="origen-container">
                  <div class="inner-headline__centered">
                    <div class="inner-headline__link loading-item">
                      <a class="btn btn-line btn-line-default" href="#process">
                        <span class="btn-caption origen-scramble">Origen Haus</span>
                      </a>
                    </div>
                    <div class="inner-headline__title banners-hover centered loading-item">
                      <h1 class="small">Creamos para tu marca
                        <a class="inner-headline__trigger banners-trigger-1" href="/proyectos"> experiencias </a> 
                        y  
                        <a class="inner-headline__trigger banners-trigger-2" href="/servicios"> soluciones de diseño</a>
                      </h1>
                    </div>

                    <div class="headline-banner-01 landscape image-01">
                      <img src="/img/illustrations/about-us-01.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-01 portrait image-02">
                      <img src="/img/illustrations/about-us-02.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-01 landscape image-03">
                      <img src="/img/illustrations/about-us-03.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-01 portrait image-04">
                      <img src="/img/illustrations/about-us-04.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-02 portrait image-05">
                      <img src="/img/illustrations/about-us-05.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-02 landscape image-06">
                      <img src="/img/illustrations/about-us-06.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-02 portrait image-07">
                      <img src="/img/illustrations/about-us-07.webp" alt="Imagen acerca de Origen">
                    </div>
                    <div class="headline-banner-02 landscape image-08">
                      <img src="/img/illustrations/about-us-08.webp" alt="Imagen acerca de Origen">
                    </div>
                  </div>
                </div>
              </div>

              <div class="inner-headline__dataline">
                <div class="origen-container">
                  <div class="headline-dataline">
                    <div class="headline-dataline__socials">
                      <ul class="origen-socials-line centered-mobile">
                        <li class="loading-item">
                          <a class="origen-socials-line__link" href="https://instagram.com/byorigenhaus" target="_blank">
                            <span class="origen-scramble">@byorigenhaus</span>
                          </a>
                        </li>
                      </ul>
                    </div>
                    <div class="headline-dataline__controls loading-item">
                      <a class="btn btn-line-icon btn-line-icon-small btn-line-default slide-down" href="#process">
                        <span class="btn-caption origen-scramble">Desliza para ver más</span>
                        <i>
                          <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 18 18">
                            <path d="M18,10.8h-3.6v-3.6h3.6v3.6ZM7.2,14.4v3.6h3.6v-3.6h3.6v-3.6h-3.6V0h-3.6v10.8h-3.6v3.6s3.6,0,3.6,0ZM3.6,10.8v-3.6H0v3.6h3.6Z"/>
