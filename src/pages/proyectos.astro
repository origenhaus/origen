---
import MainLayout from "../layouts/MainLayout.astro";
import TalkSection from "../components/TalkSection.astro";
import ClientsSection from "../components/ClientsSection.astro";
const title = "Proyectos";
---

<MainLayout
  title="Proyectos | Origen.haus — Aquí es donde todo empieza"
  description="Origen — Estudio creativo de branding, diseño web y contenido de marca"
>
    <main id=" origen-page-content" class=" origen-page-content inner-page-content">
      
      
      <div class="blur-container">
        <div class="blur-layer blur-1"></div>
        <div class="blur-layer blur-2"></div>
        <div class="blur-layer blur-3"></div>
        <div class="blur-layer blur-4"></div>
        <div class="blur-layer blur-5"></div>
        <div class="blur-layer blur-6"></div>
        <div class="blur-layer blur-7"></div>
        <div class="blur-layer blur-8"></div>
      </div>



      <div class=" origen-section blur-section">
        <div class=" origen-container grid-l-container">


          <div class=" origen-block loading-wrap">
            <div class="inner-headline margin-bottom-subtitle">
              <div class="container-fluid p-0">
                <div class="row g-0">
                  <div class="col-12  origen-grid-item">
  
                    <div class="inner-headline__breadcrumbs loading-fade">
                      <div class="breadcrumbs__nav">
                        <span>
                          <a href="/">
                            <span class=" origen-scramble">Inicio</span>
                          </a>
                        </span>
                        <span class="current-item">Proyectos
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="col-12">

                    <div class="inner-headline__content has-large-title">
                      <div class="container-fluid p-0">
                        <div class="row g-0">
                          <div class="col-12 col-xl-9  origen-grid-item">
                            <div class="inner-headline__title pre-subtitle-large">
                              <h1 class="large loading-split">Proyectos</h1>
                            </div>
                            <div class="inner-headline__subtitle loading-item">
                              <p>Selección de nuestros <span>proyectos y clientes más destacados</span></p>
                            </div>
                          </div>
                          <div class="col-12 col-xl-3  origen-grid-item">
                            <div class="inner-headline__tags align-end-desktop tags-large-subtitle">
                              <span class="tag tag-m meta-tag  origen-scramble loading-item">Sitio web</span>
                              <span class="tag tag-m meta-tag  origen-scramble loading-item">Diseño</span>
                              <span class="tag tag-m meta-tag  origen-scramble loading-item">Comunicaciones</span>
                              <span class="tag tag-m meta-tag  origen-scramble loading-item">Estrategia digital</span>
                              <span class="tag tag-m meta-tag  origen-scramble loading-item">Branding</span>
                              <span class="tag tag-m meta-tag  origen-scramble loading-item">Marketing</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>


        </div>
      </div>


      <div class=" origen-section blur-section pinned-section padding-bottom-projects">
        <div class="pinned-section__inner">
          <div class=" origen-container grid-l-container">


            <div class=" origen-block loading-fade">
              <div class=" origen-projects-grid">
