                  <div class="row g-0  origen-projects-grid__gallery">
                    <div class="col-12 col-md-6 col-xl-4  origen-project-item animate-card-3">
                      <a class=" origen-project-item__media  origen-img-anim active-cursor-permanent" data-cursor-text="Ver proyecto" href="https://inucleo.co" target="_blank">
