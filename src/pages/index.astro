                        <div class="origen-project-item__tags">
                          <span class="tag tag-s tag-medium origen-scramble">Web</span>
                          <span class="tag tag-s tag-medium origen-scramble">Diseño</span>
                          <span class="tag tag-s tag-medium origen-scramble">Estrategia digital</span>
                        </div>
                      </div>
                    </div>
                    <div class="col-12 col-xl-1 origen-project-divider"></div>
                    <div class="col-12 col-md-6 col-xl-4 origen-project-item animate-card-2 origen-project-item-s origen-project-item-sticky">
                      <a class="origen-project-item__media origen-img-anim active-cursor-permanent" data-cursor-text="Ver proyecto LP" href="/proyectos">
                        <img class="origen-img-anim__absolute" src="/img/works/showcase-grid-x3/pr02-04.webp" alt="Ver proyecto">
                        <img class="origen-img-anim__absolute" src="/img/works/showcase-grid-x3/pr02-05.webp" alt="Ver proyecto">
                        <img class="origen-img-anim__absolute" src="/img/works/showcase-grid-x3/pr02-03.webp" alt="Ver proyecto">
                        <img class="origen-img-anim__absolute" src="/img/works/showcase-grid-x3/pr02-02.webp" alt="Ver proyecto">
                        <img class="origen-img-anim__main" src="/img/works/showcase-grid-x3/pr02-01.webp" alt="Ver proyecto">
                        <div class="origen-cover origen-cover-03"></div>
                        <div class="origen-project-item__logowrap">
                          <img src="/img/works/showcase-sticky/clients/04.svg" alt="LP Contadores">
                        </div>
                      </a>
                      <div class="origen-project-item__caption">
                        <div class="origen-project-item__name">
                          <a class="project-name-s" href="/proyectos">LP Contadores</a>
                        </div>
                        <div class="origen-project-item__tags">
                          <span class="tag tag-s tag-medium origen-scramble">Web</span>
                          <span class="tag tag-s tag-medium origen-scramble">Comunicaciones</span>
                        </div>
                      </div>
                    </div>
                    
                  </div>
                  <div class="row g-0">
                    <!-- all projects link -->
                    <div class="origen-object-link">
                      <div class="container-fluid p-0">
                        <div class="row g-0 origen-object-link__wrap">
                          <div class="col-12 col-md-6 col-xl-4 origen-object-link__item justify-start">
                            <div class="origen-object-link__object origen-slide-object">
                              <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 259 260">
                                <path d="M143.9,0v28.8h-28.8V0h28.8ZM143.9,28.8v28.8h28.8v-28.8h-28.8ZM172.7,57.6v28.8h28.8v-28.8h-28.8ZM230.2,115.2v-28.8h-28.8v28.8H0v28.8h201.4v28.8h28.8v-28.8h28.8v-28.8h-28.8ZM172.7,201.6h28.8v-28.8h-28.8v28.8ZM143.9,230.4h28.8v-28.8h-28.8v28.8ZM114.3,260h28.8v-28.8h-28.8v28.8Z"/>
                              </svg>
                              
                            </div>
                          </div>
                          <div class="col-12 col-md-6 col-xl-4 origen-object-link__item justify-end">
                            <div class="origen-object-link__content">
                              <div class="origen-object-link__btnholder anim-uni-in-up">
                                <a class="btn btn-line btn-line-default" href="/proyectos">
                                  <span class="btn-caption origen-scramble">Todos los proyectos</span>
                                </a>
                              </div>
                              <a class="origen-object-link__media origen-img-anim active-cursor-permanent anim-uni-in-up" data-cursor-text="Todos los proyectos" href="/proyectos">
                                <img class="origen-img-anim__absolute centered-y" src="/img/works/todos/800x450_all02.webp" alt="Ver proyectos">
                                <img class="origen-img-anim__absolute centered-y" src="/img/works/todos/800x450_all01.webp" alt="Ver proyectos">
                                <img class="origen-img-anim__absolute centered-y" src="/img/works/todos/800x450_all04.webp" alt="Ver proyectos">
                                <img class="origen-img-anim__absolute centered-y" src="/img/works/todos/800x450_all05.webp" alt="Ver proyectos">
                                <img class="origen-img-anim__absolute centered-y" src="/img/works/todos/800x450_all06.webp" alt="Ver proyectos">
                                <img class="origen-img-anim__main" src="/img/works/todos/800x450_all03.webp" alt="Ver proyectos">
                              </a>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>


          </div>
          <div class="pinned-section__trigger"></div>
        </div>
      </div>

