---
import MainLayout from "../layouts/MainLayout.astro";
import ServicesStack from "../components/ServicesStack.astro";
import ProjectsGridGallery from "../components/ProjectsGridGallery.astro";
import TalkSection from "../components/TalkSection.astro";
import BlurAddon from "../components/BlurAddon.astro";
---

<MainLayout
  title="Origen.haus — Aquí es donde todo empieza"
  description="Origen — Estudio creativo de branding, diseño web y contenido de marca"
>
    <main id="origen-page-content" class="origen-page-content">

      
<BlurAddon />
      
      <div class="origen-section origen-hero-section no-padding-desktop origen-hero-special cursor-trail-transparent loading-wrap">

        
        <div class="origen-trail-transparent-wrapper">
          <div class="origen-trail-transparent-content">
            <img class="origen-trail-transparent-image" src="/img/cursor-trail-transparent/01_trail.webp" alt="Origen Haus Cursor Trail">
            <img class="origen-trail-transparent-image" src="/img/cursor-trail-transparent/02_trail.webp" alt="Origen Haus Cursor Trail">
            <img class="origen-trail-transparent-image" src="/img/cursor-trail-transparent/03_trail.webp" alt="Origen Haus Cursor Trail">
            <img class="origen-trail-transparent-image" src="/img/cursor-trail-transparent/04_trail.webp" alt="Origen Haus Cursor Trail">
            <img class="origen-trail-transparent-image" src="/img/cursor-trail-transparent/05_trail.webp" alt="Origen Haus Cursor Trail">
            <img class="origen-trail-transparent-image" src="/img/cursor-trail-transparent/06_trail.webp" alt="Origen Haus Cursor Trail">

          </div>
        </div>
        

        <div class="origen-hero-05">
          <div class="origen-hero-05__wrap">
            
            <div class="origen-hero-05__top">
              <div class="origen-hero-05__headline">
                <h1 class="loading-split">
                  Tu marca
                  <small>tiene una historia por contar</small>
                </h1>
              </div>
            </div>
            <div class="origen-hero-05__bottom">
              <div class="origen-hero-05__dataline">
                <div class="hero-05-dataline__socials loading-item">
                  <ul class="origen-socials-line">
                    <li>
                      <a class="origen-socials-line__link" href="https://www.instagram.com/byorigenhaus" target="_blank">
                        <span class="origen-scramble">@byorigenhaus</span>
                      </a>
                    </li>
                  </ul>
                </div>
                <p class="hero-05-dataline__caption loading-item">origen.haus - estudio creativo</p>
                <div class="hero-05-dataline__controls loading-item">
                  <a class="btn btn-line-icon btn-line-icon-small btn-line-default slide-down" href="#proyectos">
                    <span class="btn-caption origen-scramble">Desliza para explorar</span>
                    <i>
                      <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 18 18">
                        <path d="M18,10.8h-3.6v-3.6h3.6v3.6ZM7.2,14.4v3.6h3.6v-3.6h3.6v-3.6h-3.6V0h-3.6v10.8h-3.6v3.6s3.6,0,3.6,0ZM3.6,10.8v-3.6H0v3.6h3.6Z"/>
                      </svg>
                    </i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        
      </div>

      <div id="nosotros" class="origen-section  blur-section padding-top-subtitle">
        <div class="origen-container  grid-l-container">

          <div class="origen-block">
            <div class="origen-section-manifest pre-list">
              <div class="container-fluid p-0">
                <div class="row g-0">
                  <div class="col-12 origen-grid-item">
                    <div class="origen-section-manifest__wrap wrap-text-s">
                      <div class="origen-section-manifest__controls anim-uni-in-up">
                        <a class="btn btn-line btn-line-default" href="/nosotros">
                          <span class="btn-caption origen-scramble">Nosotros</span>
                        </a>
                      </div>
                      <div class="origen-section-manifest__text manifest-text-m">
                        <a class="manifest manifest-m origen-split-lines active-cursor-accent" data-cursor-text="Conoce más" href="/nosotros">
                          Somos un estudio creativo que acompaña marcas desde su <b class="bg-color-accent" style="padding: 5px; color: var(--base-tint--light)">origen.</b> <span>Trabajamos con diseño de marca, web, producción audiovisual, estrategia digital y comunicaciones ayudando a personas y negocios a definir y contar su historia.</span></a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>


        </div>
      </div>



      <div id="proyectos" class="origen-section blur-section pinned-section padding-bottom-default">
        <div class="pinned-section__inner">
          <div class="origen-container grid-l-container">


            <div class="origen-block">
              <div class="origen-projects-grid">
<ProjectsGridGallery />
              </div>
            </div>


          </div>
          <div class="pinned-section__trigger"></div>
        </div>
      </div>

      <div class="origen-section">
        <div class="origen-container fullwidth-container">


<ServicesStack />


        </div>
      </div>

<TalkSection />
      




    </main>
</MainLayout>
